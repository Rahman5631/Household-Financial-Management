# برای Supabase CLI و Edge Functions:

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ⚠️ فقط در محیط سرور (ArvanCloud Edge Functions) تعریف شود:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY_NEVER_COMMIT